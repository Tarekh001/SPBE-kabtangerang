# ============================================
# SPBE Kabupaten Tangerang — Environment Config
# ============================================
# Salin file ini sebagai .env dan isi dengan nilai yang sesuai.
# JANGAN commit file .env ke repository!
#
# Variabel dengan prefix VITE_ akan terekspos ke client-side.
# JANGAN simpan secret/token/password di variabel VITE_!
# ============================================

# Base URL API Backend
# Development: http://localhost:8000/api/v1/
# Production:  https://api.tangerangkab.go.id/spbe/v1/
VITE_API_BASE_URL=

# Mode environment (dikelola otomatis oleh Vite)
# Tidak perlu diubah manual
# VITE_MODE=development
